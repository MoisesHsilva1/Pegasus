#!/bin/bash

PEGASUS_PATH="${PEGASUS_PATH:-$HOME/.local/share/pegasus}"
[ ! -d "$PEGASUS_PATH" ] && PEGASUS_PATH="${OMAKUB_PATH:-$HOME/.local/share/omakub}"

source $PEGASUS_PATH/bin/omakub-sub/header.sh 2>/dev/null || source $PEGASUS_PATH/bin/pegasus-sub/header.sh 2>/dev/null
source $PEGASUS_PATH/bin/omakub-sub/menu.sh 2>/dev/null || source $PEGASUS_PATH/bin/pegasus-sub/menu.sh 2>/dev/null
